APP_ENV=production
SITE_URL=https://chifaglow.com
CORS_ORIGINS=https://chifaglow.com,https://www.chifaglow.com

DATABASE_URL=postgres://chifaglow:chifaglow@chifaglow_chifaglow:5432/chifaglow?sslmode=disable

GOOGLE_SHEETS_WEBHOOK_URL=

META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

SNAPCHAT_PIXEL_ID=
SNAPCHAT_CAPI_TOKEN=

MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
ENABLE_IP_FRAUD_CHECK=true

# Admin dashboard (never commit real values)
# Hash: python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt(rounds=12)).decode())"
# Wrap the hash in single quotes so `$` is not interpolated.
# Secret: python -c "import secrets; print(secrets.token_hex(32))"
# Remember-me sessions last 30 days regardless of ADMIN_JWT_HOURS.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
ADMIN_JWT_HOURS=12

META_LIVRAISON_BASE_URL=https://api.metalivraison.ma/colis-service
META_LIVRAISON_API_KEY=
META_LIVRAISON_API_SECRET=
